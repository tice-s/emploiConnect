# Copiez ce fichier en ".env" et ajustez si besoin.

# Django
SECRET_KEY=change-moi-en-production-avec-une-cle-aleatoire-longue
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de données — laisser vide en local (SQLite utilisé automatiquement).
# En production (Render), coller ici l'URL de connexion PostgreSQL fournie
# par Neon (dashboard Neon → Connection string) :
#   postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Stockage des médias (photo de profil, logo, CV importés) — laisser vide en
# local (fichiers stockés dans media/). En production, coller ici l'URL
# Cloudinary (dashboard Cloudinary → "API Environment variable") :
#   cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# IA locale (Ollama) — aucun compte, aucune clé API, aucune donnée envoyée en ligne.
# Installer Ollama : winget install --id Ollama.Ollama -e   (ou https://ollama.com)
# Puis télécharger le modèle une fois : ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
